{
  "name": "tessera-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=playground",
    "build": "turbo run build",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "vitest run --dir scripts",
    "test:browser": "turbo run test:browser",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "size": "size-limit",
    "budget": "node scripts/page-budget.mjs",
    "manifest:check": "turbo run manifest:check",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm manifest:check",
    "e2e": "playwright test",
    "docs:gen": "node scripts/gen-config-docs.mjs",
    "docs:dev": "pnpm --filter docs dev",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@changesets/cli": "^3.0.0",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^14.1.0",
    "rolldown": "1.2.12",
    "size-limit": "^14.1.0",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "zod": "^4.6.5"
  }
}
