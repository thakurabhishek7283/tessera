{
  "name": "tessera-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "turbo run dev --filter=playground",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "size": "size-limit",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@changesets/cli": "^3.0.0",
    "turbo": "^2.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
