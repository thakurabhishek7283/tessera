{
  "name": "@tessera-kit/testing",
  "version": "0.1.1",
  "description": "FakeHub, fake clock and fixtures for testing Tessera kits",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thakurabhishek7283/tessera.git",
    "directory": "packages/testing"
  },
  "author": "Abhishek Thakur",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@tessera-kit/core": "workspace:*",
    "@tessera-kit/protocol": "workspace:*",
    "@tessera-kit/storage": "workspace:*"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24",
    "zod": "^4.6.5"
  }
