{
  "name": "@tessera/react",
  "version": "0.1.0",
  "description": "React bridge: provider and hooks for Tessera",
  "license": "MIT",
  "author": "Abhishek Thakur",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@tessera/core": "workspace:*",
    "@tessera/elements": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {},
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "lit": "^3.3.3",
    "playwright": "^1.63.0",
    "react": "^19",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
