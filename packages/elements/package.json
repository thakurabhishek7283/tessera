{
  "name": "@tessera-kit/elements",
  "version": "0.1.0",
  "description": "Lit base element, design tokens and UI primitives for Tessera kits",
  "license": "MIT",
  "author": "Abhishek Thakur",
  "type": "module",
  "sideEffects": [
    "./dist/define.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/tokens.css",
    "README.md"
  ],
  "dependencies": {
    "@lit/context": "^1.1.0",
    "@tessera-kit/core": "workspace:*",
    "lit": "^3.3.0"
  },
  "scripts": {
    "build": "node scripts/sync-tokens.mjs && tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "sync-tokens": "node scripts/sync-tokens.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tessera-kit/protocol": "workspace:*",
    "@tessera-kit/storage": "workspace:*",
    "@tessera-kit/transport": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@tessera-kit/storage": "^0.1.0",
    "@tessera-kit/transport": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@tessera-kit/storage": {
      "optional": true
    },
    "@tessera-kit/transport": {
      "optional": true
    }
  }
}
