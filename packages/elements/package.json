{
  "name": "@tessera-kit/elements",
  "version": "0.1.0",
  "description": "Lit base element, design tokens and UI primitives for Tessera kits",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thakurabhishek7283/tessera.git",
    "directory": "packages/elements"
  },
  "author": "Abhishek Thakur",
  "type": "module",
  "sideEffects": [
    "./dist/define.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./tessera.manifest.json": "./dist/tessera.manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/tokens.css",
    "README.md"
  ],
  "dependencies": {
    "@lit/context": "^1.1.0",
    "@tessera-kit/core": "workspace:*",
    "lit": "^3.3.0"
  },
  "scripts": {
    "build": "node scripts/sync-tokens.mjs && tsdown && tessera-manifest build",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "sync-tokens": "node scripts/sync-tokens.mjs",
    "manifest:check": "tessera-manifest check",
    "manifest:update": "tessera-manifest check --update"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tessera-kit/manifest": "workspace:*",
    "@tessera-kit/protocol": "workspace:*",
    "@tessera-kit/storage": "workspace:*",
    "@tessera-kit/transport": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@tessera-kit/storage": "^0.1.0",
    "@tessera-kit/transport": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@tessera-kit/storage": {
      "optional": true
    },
    "@tessera-kit/transport": {
      "optional": true
    }
  },
  "tessera": {
    "manifest": {
      "category": "primitive",
      "plugin": false,
      "docs": {
        "summary": "Design tokens, <tessera-root> and the UI primitives every Tessera kit is built from: buttons, form fields, menus, dialogs, popovers, tooltips, avatars, badges and toasts.",
        "useWhen": [
          "a page needs a basic control (button, input, select, dialog) that matches the Tessera kits",
          "wrapping a page in <tessera-root> to give its kit elements an instance and a theme"
        ],
        "avoidWhen": [
          "the app already has a design system for basic controls; the kits work without these primitives on the page"
        ]
      }
    }
  }
}
