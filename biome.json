{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.vitepress/cache",
      "!**/.vitepress/dist",
      "!pnpm-lock.yaml",
      "!**/*.generated.ts",
      "!**/tessera-config.schema.json",
      "!**/tessera.manifest.api.json",
      "!packages/manifest/test/fixtures"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConfusingVoidType": "off"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/src/**", "!packages/manifest/**", "apps/playground/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Runtime code uses 'zod/mini' (ADR 5). Classic zod is for build-time tools only.",
                  "@tessera-kit/manifest": "The manifest generator is a build-time tool. Runtime packages and the playground must not import it."
                }
              }
            }
          }
        }
      }
    }
  ]
}
